# ======================================================================
#  .env template: run RD-Agent with Zhipu (智谱) GLM via LiteLLM
#  Usage:
#    cp .env.wsl.glm.example .env.wsl
#    # fill ZHIPUAI_API_KEY
#    source .env.wsl          # or export the lines you need
# ======================================================================
#
# Smoke test (run inside WSL after editing):
#   /home/administrator/.local/share/mamba/envs/rdagent/bin/python \
#     scripts/lab/_smoke_llm_ping.py
# ----------------------------------------------------------------------

# ----- LiteLLM chat model -----------------------------------------------
# Zhipu exposes an OpenAI-compatible endpoint at
#   https://open.bigmodel.cn/api/paas/v4
# so we use LiteLLM's "openai/" provider prefix and point OPENAI_API_BASE
# to Zhipu. The model name after the slash is the Zhipu model id.
#
#   - glm-4-plus     : latest flagship, best reasoning/coding (recommended)
#   - glm-4-0520     : GA version, stable
#   - glm-4-air      : cheaper/faster
#   - glm-4-flashx   : fastest / cheapest, not ideal for long prompts
#   - glm-4.6 / glm-5: set whatever your account has access to
CHAT_MODEL=openai/glm-4-plus
OPENAI_API_KEY=your_zhipu_api_key_here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4

# Optional: keep DeepSeek creds as a fallback if you want to A/B switch
# DEEPSEEK_API_KEY=

# ----- Embeddings ------------------------------------------------------
# Zhipu offers ``embedding-2`` / ``embedding-3`` on the same endpoint.
# Our patch_qlib_conda._patch_embedding_graceful_fallback returns a
# zero-vector when the endpoint is unavailable, so the loop never dies
# even if embeddings fail.
EMBEDDING_MODEL=openai/embedding-3

# ----- RD-Agent env (unchanged) ----------------------------------------
QLIB_RDAGENT_CONDA_ENV=rdagent
MODEL_CoSTEER_ENV_TYPE=conda
LIVE_OUTPUT=False

# ----- Project-specific quant loop (unchanged) -------------------------
QLIB_QUANT_QUANT_HYPOTHESIS_GEN=factor_lab.adapters.quant_proposal.ProjectQlibQuantHypothesisGen
QLIB_QUANT_FACTOR_HYPOTHESIS2EXPERIMENT=factor_lab.adapters.proposal.ProjectQlibFactorHypothesis2Experiment
QLIB_QUANT_MODEL_HYPOTHESIS2EXPERIMENT=factor_lab.adapters.proposal.ProjectQlibModelHypothesis2Experiment
QLIB_QUANT_EVOLVING_N=3
QLIB_QUANT_ACTION_SELECTION=llm

# ----- Pure factor loop (mode=factor) ------------------------------------
QLIB_FACTOR_HYPOTHESIS_GEN=factor_lab.adapters.proposal.ProjectQlibFactorHypothesisGen
QLIB_FACTOR_HYPOTHESIS2EXPERIMENT=factor_lab.adapters.proposal.ProjectQlibFactorHypothesis2Experiment

# ----- Phase-2: diversity reward ---------------------------------------
FACTOR_LAB_DIVERSITY_WEIGHT=0.4
FACTOR_LAB_CERTIFIED_PARQUET=git_ignore_folder/combined_factors_df.parquet

# ----- Phase-3: RAG ----------------------------------------------------
FACTOR_LAB_RAG_MAX_EXAMPLES=3
FACTOR_LAB_RAG_EXPLORATION_PERIOD=3

# ----- Phase-4: pre-screener (set 1 to enable) -------------------------
# FACTOR_LAB_PRESCREENER_ENABLED=1
# FACTOR_LAB_PRESCREENER_MIN_IC=0.005

# CoSTEER tuning (safe defaults for GLM)
FACTOR_CoSTEER_MAX_LOOP=4
MODEL_CoSTEER_MAX_LOOP=3
FACTOR_CoSTEER_FAIL_TASK_TRIAL_LIMIT=4
MODEL_CoSTEER_FAIL_TASK_TRIAL_LIMIT=3
FACTOR_LAB_COSTEER_MAX_LOOP=4

# ----- Optional time hints ---------------------------------------------
QLIB_FACTOR_TRAIN_START=2008-01-01
QLIB_FACTOR_TRAIN_END=2014-12-31
QLIB_FACTOR_VALID_START=2015-01-01
QLIB_FACTOR_VALID_END=2016-12-31
QLIB_FACTOR_TEST_START=2017-01-01
QLIB_FACTOR_TEST_END=2020-08-01

QLIB_MODEL_TRAIN_START=2008-01-01
QLIB_MODEL_TRAIN_END=2014-12-31
QLIB_MODEL_VALID_START=2015-01-01
QLIB_MODEL_VALID_END=2016-12-31
QLIB_MODEL_TEST_START=2017-01-01
QLIB_MODEL_TEST_END=2020-08-01
