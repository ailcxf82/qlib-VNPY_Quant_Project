# Copy to `.env` and fill in secrets. Used by RD-Agent (litellm) and optional tooling.

# ----- LiteLLM (required for rdagent fin_quant) -----
CHAT_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
# DeepSeek has no embedding model; keep embedding on compatible OpenAI endpoint if available.
# DeepSeek has no dedicated embedding endpoint; set same as chat model.
# RD-Agent's knowledge-graph embedding will fall back to zero-vector via patch_qlib_conda.py.
EMBEDDING_MODEL=deepseek/deepseek-chat
OPENAI_API_KEY=

# ----- RD-Agent: use qlib_zhengshi for qrun / model workspace (not default rdagent4qlib) -----
# WSL rdagent env: contains rdagent 0.8.0 + pyqlib 0.9.7 + qrun
QLIB_RDAGENT_CONDA_ENV=rdagent
MODEL_CoSTEER_ENV_TYPE=conda
LIVE_OUTPUT=False

# ----- Project-specific quant loop: local templates + proposal classes -----
QLIB_QUANT_QUANT_HYPOTHESIS_GEN=factor_lab.adapters.quant_proposal.ProjectQlibQuantHypothesisGen
QLIB_QUANT_FACTOR_HYPOTHESIS2EXPERIMENT=factor_lab.adapters.proposal.ProjectQlibFactorHypothesis2Experiment
QLIB_QUANT_MODEL_HYPOTHESIS2EXPERIMENT=factor_lab.adapters.proposal.ProjectQlibModelHypothesis2Experiment
QLIB_QUANT_EVOLVING_N=2
QLIB_QUANT_ACTION_SELECTION=bandit

# ----- Pure factor loop (mode=factor): hypothesis gen + experiment classes -----
QLIB_FACTOR_HYPOTHESIS_GEN=factor_lab.adapters.proposal.ProjectQlibFactorHypothesisGen
# QLIB_FACTOR_HYPOTHESIS2EXPERIMENT defaults to ProjectQlibFactorHypothesis2Experiment via quant alias above

# ----- Phase-2: diversity reward (read_exp_res.py → enhanced_score) -----
# FACTOR_LAB_DIVERSITY_WEIGHT=0.4
# FACTOR_LAB_CERTIFIED_PARQUET=git_ignore_folder/combined_factors_df.parquet

# ----- Phase-3: RAG academic factor examples in proposal -----
# FACTOR_LAB_RAG_MAX_EXAMPLES=3
# FACTOR_LAB_RAG_EXPLORATION_PERIOD=3

# ----- Phase-4: pre-screener before qrun (default OFF) -----
# FACTOR_LAB_PRESCREENER_ENABLED=1
# FACTOR_LAB_PRESCREENER_MIN_IC=0.005

# ----- CoSTEER / performance tuning -----
# FACTOR_LAB_COSTEER_MAX_LOOP=4
# FACTOR_LAB_MAX_N_EPOCHS=20

# ----- Optional time hints (see rdagent docs; YAML under rdagent_overrides is authoritative for qrun) -----
QLIB_FACTOR_TRAIN_START=2008-01-01
QLIB_FACTOR_TRAIN_END=2014-12-31
QLIB_FACTOR_VALID_START=2015-01-01
QLIB_FACTOR_VALID_END=2016-12-31
QLIB_FACTOR_TEST_START=2017-01-01
QLIB_FACTOR_TEST_END=2020-08-01

QLIB_MODEL_TRAIN_START=2008-01-01
QLIB_MODEL_TRAIN_END=2014-12-31
QLIB_MODEL_VALID_START=2015-01-01
QLIB_MODEL_VALID_END=2016-12-31
QLIB_MODEL_TEST_START=2017-01-01
QLIB_MODEL_TEST_END=2020-08-01
